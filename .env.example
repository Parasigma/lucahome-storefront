# --- Aplicación ---
APP_URL="http://localhost:3000"

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://rapidtax:rapidtax@localhost:5432/rapidtax?schema=public"

# --- Stripe ---
# Sin STRIPE_SECRET_KEY la web funciona en MODO DEMO (pago simulado) solo fuera de producción.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Pago simulado para probar el flujo sin Stripe. Se ignora si hay STRIPE_SECRET_KEY. Ponlo en "false" en producción.
PAYMENTS_DEMO="true"

# --- Correo (SMTP). Sin SMTP_HOST los correos se escriben en la consola del servidor ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Rapid Tax <no-reply@rapidtax.example>"
# Dirección que recibe los avisos de nuevos expedientes
ADMIN_NOTIFY_EMAIL=""

# --- Administrador inicial (npm run db:seed) ---
ADMIN_EMAIL="admin@rapidtax.example"
ADMIN_PASSWORD="cambia-esta-contraseña"

# --- Almacenamiento de documentos (fuera de /public) ---
UPLOAD_DIR="./storage/uploads"
